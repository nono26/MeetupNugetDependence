<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../backend.application/backend.application.csproj" />
  </ItemGroup>
    <ItemGroup>
    <!--
      Both serializers are referenced here so the demo can show both implementations.
      In a real wrap-then-replace scenario, you would start with only Newtonsoft.Json,
      then add System.Text.Json when you're ready to replace, then remove Newtonsoft.Json
      once the contract tests pass and the switch is made in DI registration.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
  </ItemGroup>

</Project>
