{
    "name": ".NET in Codespaces",
    "image": "mcr.microsoft.com/dotnet/sdk:10.0",
    "postCreateCommand": "dotnet tool update --global CycloneDX --version 6.3.1 || dotnet tool install --global CycloneDX --version 6.3.1; if ! command -v grype >/dev/null 2>&1; then curl -sSfL https://raw.githubusercontent.com/anchore/grype/main/install.sh -o /tmp/install-grype.sh && sh /tmp/install-grype.sh -b \"$HOME/.dotnet/tools\" && rm /tmp/install-grype.sh; fi",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {},
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "2"
        },
        "ghcr.io/devcontainers/features/powershell:1": {
            "version": "latest"
        },
        "ghcr.io/azure/azure-dev/azd:0": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/common-utils:2": {},
        "ghcr.io/devcontainers/features/dotnet:2": {
            "version": "none",
            "dotnetRuntimeVersions": "10.0",
            "aspNetCoreRuntimeVersions": "10.0"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "GitHub.copilot",
                "ms-dotnettools.vscode-dotnet-runtime",
                "ms-dotnettools.csdevkit",
                "ms-dotnetools.csharp",
                "ms-ceintl.vscode-language-pack-fr",
                "ms-vscode.powershell",
                "mhutchie.git-graph",
                "yzhang.markdown-all-in-one",
                "pkief.material-icon-theme",
                "patcx.vscode-nuget-gallery",
                "mechatroner.rainbow-csv",
                "tomoki1207.pdf",
                "redhat.vscode-yaml",
                "mermaidchart.vscode-mermaid-chart",
                "esbenp.prettier-vscode",
                "rangav.vscode-thunder-client",
                "hbenl.vscode-test-explorer"
            ]
        }
    },
    "forwardPorts": [
        8080,
        8081
    ],
    "hostRequirements": {
        "memory": "8gb",
        "cpus": 4
    },
    "remoteEnv": {
        "DOTNET_MULTILEVEL_LOOKUP": "0",
        "TARGET": "net10.0"
    }   
}
